{
  "schema_version": 1,
  "principle": "registered != enabled != visible != authorized",
  "builtins": [
    {
      "id": "shell",
      "required": true,
      "purpose": "repository inspection, build, test, and bounded engineering commands",
      "authorization": "active permission profile + approval policy + rules/hooks"
    },
    {
      "id": "web_search",
      "required": false,
      "purpose": "current official provider/framework contract research",
      "authorization": "active task and repository research policy"
    },
    {
      "id": "multi_agent",
      "required": false,
      "purpose": "read-only mapping/research plus bounded review/verification",
      "authorization": "execute-phase orchestration protocol"
    }
  ],
  "mcp_servers": [],
  "mcp_policy": {
    "default": "bounded-by-hook-policy",
    "collection_calls": {
      "require_filter": true,
      "require_page_size": true,
      "maximum_page_size": 100
    },
    "response_budget": {
      "maximum_utf8_bytes": 24000,
      "oversize_behavior": "drop_result_and_request_narrower_query"
    },
    "requirements": [
      "explicit server identity",
      "bounded enabled tool list",
      "approval behavior",
      "timeout",
      "required-vs-optional startup semantics",
      "pagination and filter rules for collection-returning operations",
      "deterministic response-size cap for all MCP results"
    ],
    "tools": [
      {
        "tool_name": "mcp__db__query_rows",
        "behavior": "collection",
        "capability": {
          "registered": true,
          "enabled": true,
          "visible": true,
          "authorized": true
        },
        "required_scope_fields": [
          "filter"
        ],
        "pagination": {
          "field": "limit",
          "required": true,
          "maximum": 100
        },
        "result_size": {
          "maximum_utf8_bytes": 24000
        }
      },
      {
        "tool_name": "mcp__portfolio__fetchSnapshot",
        "behavior": "collection",
        "capability": {
          "registered": true,
          "enabled": true,
          "visible": true,
          "authorized": true
        },
        "required_scope_fields": [
          "account_scope"
        ],
        "pagination": {
          "field": "batch_count",
          "required": true,
          "maximum": 40
        },
        "result_size": {
          "maximum_utf8_bytes": 16000
        }
      }
    ]
  }
}
