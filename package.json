{
  "name": "alpaca-paper-trader-control-plane",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.1",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "config:check": "tsx scripts/config-check.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed-dev.ts",
    "verify:runtime": "tsx scripts/verify-runtime.ts",
    "verify:local-controls": "tsx scripts/verify-local-controls.ts",
    "verify:decision-context": "tsx scripts/verify-decision-context.ts",
    "verify:local-restart": "tsx scripts/verify-local-restart.ts",
    "dev:db:up": "docker compose up -d db",
    "dev:db:reset": "docker compose down --remove-orphans && docker compose up -d db",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify:offline": "corepack pnpm typecheck && corepack pnpm test && corepack pnpm config:check && node scripts/control-plane/check-paper-only.mjs && node scripts/verify-no-live-routes.mjs"
  },
  "dependencies": {
    "@msgpack/msgpack": "3.1.3",
    "drizzle-orm": "^0.44.5",
    "fastify": "^5.6.1",
    "pg": "^8.16.3",
    "ws": "8.22.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "@types/pg": "^8.15.5",
    "@types/ws": "^8.18.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
