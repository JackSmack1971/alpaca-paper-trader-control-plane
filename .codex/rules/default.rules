# These rules constrain commands that request execution outside the sandbox.
# They do not grant filesystem/network authority and do not replace AGENTS.md policy.

prefix_rule(
    pattern = ["git", "reset", "--hard"],
    decision = "forbidden",
    justification = "Do not discard repository state. Preserve user work and use a reversible, scoped alternative.",
    match = ["git reset --hard", "git reset --hard HEAD~1"],
)

prefix_rule(
    pattern = ["git", "clean"],
    decision = "prompt",
    justification = "Cleaning untracked files can destroy user work; require explicit review of the exact target.",
    match = ["git clean -fd", "git clean -n"],
)

prefix_rule(
    pattern = ["git", "push", "--force"],
    decision = "forbidden",
    justification = "Do not force-push shared history. Use a non-destructive push or request a deliberate operator decision.",
    match = ["git push --force", "git push --force origin main"],
)

prefix_rule(
    pattern = ["git", "push"],
    decision = "prompt",
    justification = "Push is an external source-control publication boundary and requires explicit authorization.",
    match = ["git push", "git push origin feature"],
    not_match = ["git status"],
)

prefix_rule(
    pattern = ["gh", "pr", "create"],
    decision = "prompt",
    justification = "Creating a pull request is an external change-management side effect and requires explicit authorization.",
    match = ["gh pr create", "gh pr create --fill"],
)
