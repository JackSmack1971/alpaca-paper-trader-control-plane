{
  "description": "Project control-plane lifecycle and repository guard hooks. Review and trust this project hook configuration before use.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/session-start.mjs\"",
            "commandWindows": "cmd.exe /d /c .codex\\hooks\\run-hook.cmd session-start",
            "timeout": 10,
            "additionalContextLimit": 1800,
            "statusMessage": "Loading active project phase"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/pre-tool-use.mjs\"",
            "commandWindows": "cmd.exe /d /c .codex\\hooks\\run-hook.cmd pre-tool-use",
            "timeout": 5,
            "statusMessage": "Checking repository command policy"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/post-tool-use.mjs\"",
            "commandWindows": "cmd.exe /d /c .codex\\hooks\\run-hook.cmd post-tool-use",
            "timeout": 5,
            "additionalContextLimit": 100,
            "statusMessage": "Checking command result"
          }
        ]
      },
      {
        "matcher": "^mcp__.*$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/post-tool-use.mjs\"",
            "commandWindows": "cmd.exe /d /c .codex\\hooks\\run-hook.cmd post-tool-use",
            "timeout": 5,
            "additionalContextLimit": 120,
            "statusMessage": "Bounding MCP result"
          }
        ]
      }
    ]
  }
}
